<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.WholphinCompanion</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.WholphinCompanion</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.6" >
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.6">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Data" Version="10.11.6">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="stylecop.json" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <None Remove="Configuration\configPage.css" />
    <EmbeddedResource Include="Configuration\configPage.css" />
    <None Remove="Configuration\configPage.js" />
    <EmbeddedResource Include="Configuration\configPage.js" />
  </ItemGroup>

  <Target Name="CopyWholphinCompanionOutput" AfterTargets="Build">
    <PropertyGroup>
      <WholphinCompanionOutputDir>$(OutputPath)Wholphin Companion\</WholphinCompanionOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <WholphinCompanionFiles Include="$(OutputPath)$(AssemblyName).deps.json" />
      <WholphinCompanionFiles Include="$(OutputPath)$(AssemblyName).dll" />
      <WholphinCompanionFiles Include="$(OutputPath)$(AssemblyName).pdb" />
      <WholphinCompanionFiles Include="$(OutputPath)$(AssemblyName).xml" />
    </ItemGroup>
    <MakeDir Directories="$(WholphinCompanionOutputDir)" />
    <Copy SourceFiles="@(WholphinCompanionFiles)" DestinationFolder="$(WholphinCompanionOutputDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
